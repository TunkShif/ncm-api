### CORS资源共享设置
## 如果你需要配置, 请取消下面的注释并设置具体的域名
# CORS_ALLOW_ORIGIN = "*"

### 代理设置
## 启用反向代理
ENABLE_PROXY = false
## 代理配置
PROXY_URL = "https://your-proxy-url.com/?proxy="

### 随机IP设置
## 启用随机中国IP（默认关闭）；启用后，所有请求默认使用随机中国IP，除非请求参数randomCNIP显式关闭
ENABLE_RANDOM_CN_IP = false

### UnblockNeteaseMusic 设置项
## 启用全局解灰, 无论是否调用参数都会使用解灰(不推荐开启)
ENABLE_GENERAL_UNBLOCK = false
## 歌曲启用无损音质
ENABLE_FLAC = true
## 启用无损音质时，是否选择音质最高的
SELECT_MAX_BR = false
## 严格按照配置音源设置顺序进行匹配
FOLLOW_SOURCE_ORDER = true
## Cookie设置项; 推荐在Vercel等平台进行环境变量的设置或者设置github secret
# 网易云 cookie
# 格式：MUSIC_U=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NETEASE_COOKIE = ""

### 访问控制（本 fork 新增）
## 允许的 API token，逗号分隔，每个使用者一个。为空则不做校验，仅用于本地开发
API_TOKENS = ""

### 限流（本 fork 新增）
## 每个 token 在一个窗口内的最大请求数
RATE_LIMIT = 300
RATE_LIMIT_WINDOW_MS = 60000

### 请求体与上传限制（本 fork 新增）
MAX_BODY_SIZE = "8mb"
MAX_UPLOAD_SIZE_MB = 8
## 音乐客户端不上传文件，默认关闭
ENABLE_UPLOAD = false

### 关闭的接口（本 fork 新增）
## 逗号分隔，按完整路径段匹配；不要写 /login，那会一并关掉二维码登录
BLOCKED_ROUTES = "/captcha,/login/cellphone,/register,/cloud,/audio/match,/avatar"

### 不下发 Set-Cookie（本 fork 新增）
DISABLE_SET_COOKIE = true
